<h1>You are welcome!</h1>
<p>Milosty prosim</p>
<form action="/visit" method="POST">
  <div class="form-group">
    <label for="exampleInputEmail1">Ваше имя</label>
    <input name="username" type="text" class="form-control" id="exampleInputEmail1" placeholder="Введите ваше имя">
  </div>
  <div class="form-group">
    <label for="exampleInputEmail1">Ваше телефон</label>
    <input name="userphone" type="text" class="form-control" id="exampleInputEmail1" placeholder="Введите ваш телефон">
  </div>
  <div class="form-group">
    <label for="exampleInputEmail1">Когда вас ждать?</label>
    <input name="usertime" type="text" class="form-control" id="exampleInputEmail1" placeholder="Когда вас ждать?">
  </div>
  <div class="form-group">
    <label for="exampleInputEmail1">Ваш паркмахер:?</label>
    <select class="form-select" aria-label="Пример выбора по умолчанию">
      <option selected>Откройте это меню выбора</option>
      <option value="1">Гектро</option>
      <option value="2">Мансурик</option>
      <option value="3">Георгий</option>
    </select>
  </div>
  <button type="submit" class="btn btn-primary">Записаться</button>
</form>
